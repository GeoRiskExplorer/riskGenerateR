library(sf)

# 1. Create a bounding box (e.g., 0 to 10 on both axes)
bbox <- st_sfc(st_polygon(list(matrix(c(0,0, 10,0, 10,10, 0,10, 0,0), ncol=2, byrow=TRUE))))

# 2. Generate random seed points within the box
points <- st_sample(bbox, size = 15)

# 3. Create Voronoi polygons and clip them to the bounding box
voronoi <- st_voronoi(st_union(points), envelope = bbox)
polygons <- st_intersection(st_cast(voronoi, "POLYGON"), bbox)

plot(polygons, col = terrain.colors(15))
